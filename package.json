{
  "name": "dopamine-fast",
  "version": "0.5.1",
  "description": "A finite-feed guardrail for Reddit, X, Instagram and YouTube.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arturosdg/dopamine-fast.git"
  },
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "npm run zip:firefox && npm run zip:chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "test": "vitest run",
    "typecheck": "wxt prepare && tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run build && npm run build:chrome"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.21.2"
  }
}
